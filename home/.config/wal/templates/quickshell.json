{{
    "meta": {{
        "schemaVersion": 1,
        "checksum": "{checksum}",
        "wallpaper": "{wallpaper}"
    }},
    "ui": {{
        "panel": "{background}",
        "panelRaised": "{background.lighten(4)}",
        "panelHighlight": "{background.lighten(10)}",
        "panelTranslucent": "{background.adjust_alpha(95).hex_argb}",
        "frameBorder": "{color4}",
        "moduleLabel": "{color6}",
        "moduleValue": "{foreground}",
        "textMuted": "{color8}",
        "separator": "{color4.adjust_alpha(38).hex_argb}"
    }},
    "accents": {{
        "primary": "{color4}",
        "secondary": "{color5}",
        "tertiary": "{color3}"
    }},
    "status": {{
        "danger": "#FF7A7A",
        "warning": "#F4C76D",
        "success": "#75D69A"
    }},
    "terminal": {{
        "background": "{background}",
        "foreground": "{foreground}",
        "color0": "{color0}",
        "color1": "{color1}",
        "color2": "{color2}",
        "color3": "{color3}",
        "color4": "{color4}",
        "color5": "{color5}",
        "color6": "{color6}",
        "color7": "{color7}",
        "color8": "{color8}",
        "color9": "{color9}",
        "color10": "{color10}",
        "color11": "{color11}",
        "color12": "{color12}",
        "color13": "{color13}",
        "color14": "{color14}",
        "color15": "{color15}"
    }}
}}
