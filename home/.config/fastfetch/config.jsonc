{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "__HOME__/.config/fastfetch/L_ascii.txt",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2,
      "bottom": 0
    },
    "printRemaining": true
  },

  "display": {
    "pipe": false,
    "separator": "  •  ",
    "color": {
      "keys": "31",
      "separator": "90"
    },
    "brightColor": false,
    "duration": {
      "abbreviation": false
    },
    "key": {
      "width": 16,
      "type": "string"
    },
    "percent": {
      "type": ["bar", "bar-monochrome", "hide-others"],
      "ndigits": 0
    },
    "bar": {
      "char": {
        "elapsed": "━ ",
        "total": "━ "
      },
      "border": null,
      "color": {
        "elapsed": "31",
        "total": "90"
      },
      "width": 10
    }
  },

  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "key": "Host      ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "host",
      "key": "Machine   ",
      "format": "{vendor} {family}"
    },
    {
      "type": "os",
      "key": "Distro    ",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "OS        ",
      "format": "{sysname}"
    },
    {
      "type": "de",
      "key": "DE        "
    },
    {
      "type": "wm",
      "key": "WM        "
    },
    {
      "type": "terminal",
      "key": "Terminal  ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "Shell     ",
      "format": "{pretty-name}"
    }, 
    {
      "type": "cpu",
      "key": "CPU       ",
      "format": "{name}"
    },
    {
      "type": "cpuusage",
      "key": "CPU Load  "
    },
    {
      "type": "memory",
      "key": "Memory    ",
      "format": "{percentage-bar}"
    },
    {
      "type": "disk",
      "key": "Disk      ",
      "folders": "/",
      "format": "{size-percentage-bar}"
    },
    {
      "type": "battery",
      "key": "Battery   ",
      "format": "{capacity-bar}"
    },
    {
      "type": "display",
      "key": "Resolution",
      "format": "{width}x{height}"
    },
    {
      "type": "uptime",
      "key": "Uptime    "
    },
    ]
}
